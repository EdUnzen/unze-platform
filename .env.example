# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Vollständiger Publishable Key (anon) — muss mit eyJ beginnen, ~200+ Zeichen, KEIN ... am Ende
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.paste-full-key-here.no-truncation

# Nur Server-seitig — für Demo-Seed (`npm run seed:demo`) & Signed URLs
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Vorbereitung, noch nicht aktiv
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Beta: Simulierte Communities/Feed/Notifications wenn Supabase fehlt (Standard: auto)
# NEXT_PUBLIC_DEMO_MODE=true
