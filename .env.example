# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon Key aus Supabase → API: Legacy JWT (eyJ…, 3 Segmente) ODER Publishable (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.paste-full-key-here.no-truncation

# Nur Server-seitig — für Demo-Seed (`npm run seed:demo`) & Signed URLs
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Sandbox (Testmodus — sk_test_ / pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook: stripe listen --forward-to localhost:3002/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Plattform (Production: https://www.unzeconnect.app)
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Landingpage (Production: https://www.unze.app)
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002

# Feed deaktiviert (Phase 1 — Social-Media-Feed aus UI/DB-Schreibzugriff)
# NEXT_PUBLIC_FEED_ENABLED=true

# Business / Studio (UNZE Business Landing + internes Studio)
# E-Mail-Benachrichtigung bei neuer Anfrage (keine Auto-Antwort an Kunden)
BUSINESS_NOTIFY_EMAIL=support@unze.app
# Optional: Resend fuer Admin-Benachrichtigungen
# RESEND_API_KEY=re_...
# BUSINESS_EMAIL_FROM=UNZE Business <noreply@unze.app>
# Web-Statistik läuft über eigene UNZE-Datenbank (studio.page_views) — kein externes Abo nötig.
# Migration: npm run db:migrate:studio
# NEXT_PUBLIC_DEMO_MODE=true
